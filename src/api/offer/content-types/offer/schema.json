{
  "kind": "collectionType",
  "collectionName": "offers",
  "info": {
    "singularName": "offer",
    "pluralName": "offers",
    "displayName": "Offer",
    "description": "Offerte viaggio con date e prezzi specifici"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "trip": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::trip.trip",
      "inversedBy": "offers"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "depositPrice": {
      "type": "decimal",
      "required": true
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "maxParticipants": {
      "type": "integer",
      "required": true
    },
    "occupiedSeats": {
      "type": "integer",
      "default": 0
    },
    "participants": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    },
    "itinerary": {
      "type": "component",
      "repeatable": true,
      "component": "itinerary.day"
    },
    "allowInstallments": {
      "type": "boolean",
      "default": false
    },
    "installmentsCount": {
      "type": "integer",
      "default": 3
    },
    "installmentConfigs": {
      "type": "component",
      "repeatable": true,
      "component": "booking.installment-config"
    }
  }
}